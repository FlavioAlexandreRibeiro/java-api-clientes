      "response": []
    },
    {
      "name": "Testar Validação - Telefone Inválido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"João Silva\",\n  \"email\": \"joao@example.com\",\n  \"telefone\": \"abc123\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/clientes",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["clientes"]
        },
        "description": "Testa validação - telefone com formato inválido (deve retornar 400)"
      },
      "response": []
    },
    {
      "name": "Testar Email Duplicado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Maria Santos\",\n  \"email\": \"joao@example.com\",\n  \"telefone\": \"11988888888\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/clientes",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["clientes"]
        },
        "description": "Testa email duplicado - use um email já cadastrado (deve retornar 409)"
      },
      "response": []
    },
    {
      "name": "Testar Cliente Não Encontrado",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/clientes/999",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["clientes", "999"]
        },
        "description": "Testa busca de cliente inexistente (deve retornar 404)"
      },
      "response": []
    }
  ]
}
