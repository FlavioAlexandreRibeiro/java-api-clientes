        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"João Silva\",\n  \"email\": \"email-invalido\",\n  \"telefone\": \"11999999999\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/clientes",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["clientes"]
        },
        "description": "Testa validação - email inválido (deve retornar 400)"
